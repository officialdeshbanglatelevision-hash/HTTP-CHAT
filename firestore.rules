rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isChatMember(chatId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
      );
    }

    // Connection test collection
    match /test/connection {
      allow read, write: if isSignedIn();
    }

    // User profiles and subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || userId == 'acp_ai_assistant';
      allow delete: if false;

      match /contacts/{contactUid} {
        allow read, write: if isOwner(userId);
      }

      match /blocked/{blockedUid} {
        allow read, write: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      match /securityEvents/{eventId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Pairing Sessions for Linked Devices
    match /pairingSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.primaryUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.primaryUid == request.auth.uid ||
        request.resource.data.primaryUid == request.auth.uid
      );
    }

    // Calls collection for WebRTC voice and video calls
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.callerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );

      match /callerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // Channels
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.adminUids != null && request.auth.uid in resource.data.adminUids)
      );

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          get(/databases/$(database)/documents/channels/$(channelId)).data.ownerUid == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.adminUids
        );
      }

      match /subscribers/{subscriberUid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isOwner(subscriberUid);
      }
    }

    // Username reservations
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() 
        && resource.data.uid == request.auth.uid;
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.members
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.members
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.members ||
        request.auth.uid in request.resource.data.members
      );
      allow delete: if isSignedIn() && (
        request.auth.uid in resource.data.members
      );

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) 
          && (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == "acp_ai_assistant");
        allow update: if isChatMember(chatId);
        allow delete: if isChatMember(chatId) 
          && (resource.data.senderId == request.auth.uid || resource.data.senderId == "acp_ai_assistant");
      }

      // Typing indicators subcollection
      match /typing/{userId} {
        allow read: if isChatMember(chatId);
        allow write: if isChatMember(chatId) && (isOwner(userId) || userId == "acp_ai_assistant");
      }
    }

    // Blocked users
    match /blockedUsers/{userId}/users/{blockedUid} {
      allow read, write: if isOwner(userId);
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
